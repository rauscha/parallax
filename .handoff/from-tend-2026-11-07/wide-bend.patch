diff -ruN a/dsp/shim/fm_shim.cc b/dsp/shim/fm_shim.cc
--- a/dsp/shim/fm_shim.cc	2026-11-06 23:15:33.701948047 -0600
+++ b/dsp/shim/fm_shim.cc	2026-11-06 23:15:33.721668829 -0600
@@ -291,17 +291,17 @@
   g_note_down = false;
 }
 
-// Semitones, +/-. msfa hardcodes a 3-semitone bend range in Dx7Note::compute,
-// so this maps semitones onto that range; anything wider would need the
-// vendored constant changed. Recorded rather than silently clamped away.
+// Semitones, +/-. Dx7Note::compute scales this value so that 8192 units are 3
+// semitones, but nothing in msfa limits it, so the voice follows much further.
+// The limit here keeps the scaled value well inside its int32.
 EMSCRIPTEN_KEEPALIVE
 void fm_set_pitch_bend(float semitones) {
-  const float kRange = 3.0f;
-  float norm = semitones / kRange;
-  if (norm > 1.0f) norm = 1.0f;
-  if (norm < -1.0f) norm = -1.0f;
+  const float kUnitsPerSemitone = 8192.0f / 3.0f;
+  const float kLimit = 48.0f;
+  if (semitones > kLimit) semitones = kLimit;
+  if (semitones < -kLimit) semitones = -kLimit;
   g_controllers.values_[kControllerPitch] =
-      0x2000 + static_cast<int>(norm * 8191.0f);
+      0x2000 + static_cast<int>(semitones * kUnitsPerSemitone);
 }
 
