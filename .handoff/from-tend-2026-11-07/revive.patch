+// Lifts a held note that has faded more than `db` below its peak, without a new
+// strike. A note that hasn't faded that far doesn't change at all.
+EMSCRIPTEN_KEEPALIVE
+void fm_revive(float db) {
+  if (!g_note_alive || !g_note_down || db < 0.0f) return;
+  const float kUnitsPerDb = static_cast<float>(1 << 24) / 6.0206f;
+  g_note.revive(static_cast<int32_t>(db * kUnitsPerDb));
+}
