+int32_t Env::stagetarget(int ix) const {
+  int actuallevel = scaleoutlevel(levels_[ix]) >> 1;
+  actuallevel = (actuallevel << 6) + outlevel_ - 4256;
+  actuallevel = actuallevel < 16 ? 16 : actuallevel;
+  // level here is same as Java impl
+  return actuallevel << 16;
+}
+
+// [tend modification, 2026-11-07] See env.h. It sets up a climb that leaves stage
+// `next - 1`, so that arriving carries on into stage `next` as any stage would.
+void Env::revive(int32_t drop) {
+  if (!down_ || (ix_ == 0 && rising_)) return;  // released, or still in its attack
+  int32_t peak = stagetarget(0);
+  for (int i = 1; i < 3; i++) peak = max(peak, stagetarget(i));
+  const int32_t aim = peak - drop;
+  if (aim <= level_) return;  // hasn't faded that far, which is most sounds
+  int next = 1;
+  while (next < 3 && stagetarget(next) > aim) next++;
+  advance(0);  // for the attack's rate
+  ix_ = next - 1;
+  targetlevel_ = aim;
+  rising_ = true;
+}
